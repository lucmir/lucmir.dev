# Canonical site URL used in metadata, sitemap, OG tags.
# Defaults to https://lucas-cunha.com if unset.
NEXT_PUBLIC_SITE_URL=https://lucas-cunha.com

# Classic personal access token for the GitHub GraphQL API.
# Used by the Activity widget to fetch your contribution heatmap.
# Required scope: read:user only.
# Generate at: https://github.com/settings/tokens/new
# Also enable "Include private contributions on my profile" at:
# https://github.com/settings/profile
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
